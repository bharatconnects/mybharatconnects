# ─── App ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# ─── MongoDB ─────────────────────────────────────────
# Atlas (cloud, recommended for no-Docker dev):
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/bharatbridge?retryWrites=true&w=majority
MONGODB_URI=mongodb://admin:bharatbridge_dev@localhost:27017/bharatbridge?authSource=admin

# ─── JWT ─────────────────────────────────────────────
# Both secrets MUST be at least 32 characters long. The app will throw
# at boot if either is missing or shorter than 32 chars (see S5 hardening).
# Recommended: 64+ chars from a CSPRNG (e.g. `openssl rand -hex 48`).
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_64_char_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email OTP ───────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Set to "true" once SES is out of sandbox and noreply@mybharatconnects.com is verified.
EMAIL_ENABLED=false

# ─── Google OAuth (frontend-mediated authorization-code flow) ─────────
# Get these from Google Cloud Console → APIs & Services → Credentials
# → Create OAuth client ID (type: Web application).
#
# The redirect URI is on the FRONTEND (not the backend) — Google sends the
# auth code to the SPA, which then POSTs it to /auth/google/exchange where
# this server exchanges code + client_secret for tokens. JWTs never appear
# in a URL this way (no browser-history / referer / access-log leakage).
#
# Required Google Console config:
#   • Authorized JavaScript origins:  http://localhost:4200
#   • Authorized redirect URIs:       http://localhost:4200/auth/google/callback
#
# CLIENT_ID is also exposed to the frontend (apps/web/src/environments/
# environment.ts → googleClientId). CLIENT_SECRET stays server-only.
# When either is a placeholder the app boots, but /auth/google/exchange
# returns 401 at runtime.
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace_me

# ─── reCAPTCHA v3 ────────────────────────────────────
# Guards the public POST /leads and POST /auth/register endpoints against
# bot spam (RecaptchaService). Site key is exposed to the frontend
# (apps/web/src/environments/environment.ts → recaptchaSiteKey). Secret
# key stays server-only.
#
# Left commented out on purpose, unlike this file's other integrations —
# RecaptchaService checks for this being literally absent (not just a
# placeholder) to skip verification entirely, so uncomment ONLY once you
# have a real secret to put here. A "replace_me"-style value would be read
# as "configured" and every lead/register call would fail against Google's
# API with a bogus secret, unlike Google OAuth/Stripe above where a
# placeholder just 401s at the moment that specific feature is used.
# RECAPTCHA_SECRET_KEY=replace_me
# Minimum acceptable bot-likelihood score (0.0 = definitely a bot, 1.0 =
# definitely human). 0.5 is Google's own suggested default.
RECAPTCHA_MIN_SCORE=0.5

# ─── Stripe ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd


# ─── AWS (S3 documents + SES email) ──────────────────
# S3 (document storage) and SES (transactional email — OTP, welcome, case
# updates, password resets).
#
# SES note: until production-launch, SES runs in "sandbox" mode and can only
# send to verified addresses. Submit a "request production access" form in
# the AWS console (approval is typically 1–3 business days).
#
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are OPTIONAL — leave them unset in
# production. When unset, S3Service/EmailService omit `credentials` entirely
# and the AWS SDK's default provider chain takes over, which picks up the
# ECS task role's scoped permissions automatically. Only set them for local
# dev against a real bucket/SES sender with your own IAM user; the S3
# integration still requires AWS_REGION + AWS_S3_BUCKET either way, and SES
# sending is separately gated by EMAIL_ENABLED (see below), not by whether
# keys are present.
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=replace_me
# AWS_SECRET_ACCESS_KEY=replace_me
AWS_S3_BUCKET=bharatbridge-documents
AWS_CLOUDFRONT_URL=https://replace_me.cloudfront.net
SES_FROM_EMAIL=noreply@mybharatconnects.com
SES_FROM_NAME=MyBharatConnects

# ─── Throttle / Rate limiting ────────────────────────
# Global default: 100 requests / 60s per client IP. Hot/abuse-prone
# endpoints are tightened per-route via @Throttle decorators: login,
# register, forgot-password, reset-password, verify-otp, google/exchange
# (AuthController), and the public lead-capture POST /leads
# (LeadsController).
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Set to "true" only in test environments to disable rate limiting.
THROTTLE_DISABLED=false

# ─── Scheduled tasks ─────────────────────────────────
# When "true", all @Cron jobs in TasksService early-return without doing
# work. ScheduleModule still registers so the app boots normally.
# Used by the e2e suite to keep cron from firing during tests.
TASKS_DISABLED=false

# ─── Invoicing (Phase 3) ─────────────────────────────
# Two-letter Indian state code used by the GST math: when an invoice's
# billing-address state matches this value the system splits GST into
# CGST+SGST (intra-state); otherwise it applies IGST (inter-state).
COMPANY_STATE=MH


