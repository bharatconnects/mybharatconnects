{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "testEnvironment": "node",
  "testRegex": "test/live/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^uuid$": "<rootDir>/test/__mocks__/uuid.ts"
  },
  "testTimeout": 120000,
  "forceExit": true,
  "maxWorkers": 1
}
